# CoinGecko Demo API Key
# Get from: https://www.coingecko.com/en/api
COINGECKO_DEMO_API_KEY=your_coingecko_api_key_here

# Binance Public API (no key needed for public endpoints)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Supabase (optional - not required for public access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Vite public env vars (for client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_APP_ID=cryptolens-market

# App
JWT_SECRET=your_jwt_secret_here
PORT=3000
NODE_ENV=production
